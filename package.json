{
  "name": "kanban-board-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Local Project Management MVP with a Kanban board and AI assistant.",
  "workspaces": [
    "apps/frontend/web",
    "packages/*"
  ],
  "scripts": {
    "frontend:build": "npm --workspace @kanban/web run build",
    "frontend:check": "npm --workspace @kanban/web run check",
    "frontend:lint": "npm --workspace @kanban/web run lint",
    "frontend:test": "npm --workspace @kanban/web run test",
    "types:build": "npm --workspace @kanban/types run build",
    "types:check": "npm --workspace @kanban/types run check"
  }
}
